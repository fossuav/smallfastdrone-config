{
  "name": "smallfastdrone-config",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "setup": "./scripts/dev-setup.sh",
    "sitl:build": "./scripts/sitl-build.sh",
    "sitl:start": "./scripts/sitl-start.sh",
    "sitl:stop": "./scripts/sitl-stop.sh",
    "bridge:start": "bun run test/sitl/bridge.ts",
    "dev": "vite",
    "dev:sitl": "./scripts/dev-with-sitl.sh",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug"
  },
  "dependencies": {
    "@nuxt/ui": "^4.7.1",
    "@tresjs/cientos": "^5.7.1",
    "@tresjs/core": "^5.8.1",
    "@vueuse/core": "^14.3.0",
    "mavlink-mappings": "^1.0.22-20260311",
    "node-mavlink": "^2.3.0",
    "pinia": "^3.0.4",
    "tailwindcss": "^4.3.0",
    "vue": "^3.5.13",
    "vue-router": "^5.0.7"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@playwright/test": "^1.60.0",
    "@types/bun": "^1.3.14",
    "@types/w3c-web-serial": "^1.0.8",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^10.4.0",
    "typescript": "^5.7.3",
    "vite": "^7.0.0",
    "vite-plugin-mkcert": "^2.0.0",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vite-plugin-pwa": "^1.3.0",
    "vue-tsc": "^2.2.0"
  }
}
